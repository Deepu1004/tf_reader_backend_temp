<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Deliberately small.

  Spotless already handles all formatting, so nothing here is about layout.
  These are the rules that catch a real problem or enforce something in STYLE.md.

  Everything is severity=error, because a warning nobody has to fix is not a rule.
  If a rule below turns out to be noise on this codebase, DELETE IT rather than
  downgrading it to a warning. A config full of ignored warnings teaches the team
  that the build's opinion does not matter.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Files must end with a newline. Avoids a pointless diff line forever. -->
  <module name="NewlineAtEndOfFile"/>

  <module name="TreeWalker">

    <!-- ── imports ────────────────────────────────────────────────────────── -->
    <!-- A star import hides where a name came from, and breaks silently when
         two packages both export it. -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports">
      <property name="processJavadoc" value="true"/>
    </module>
    <module name="RedundantImport"/>
    <!-- Nothing in a Spring app should need these. Almost always a mistake. -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun,com.sun,jdk.internal"/>
    </module>

    <!-- ── the STYLE.md budgets, as build rules ──────────────────────────── -->
    <!-- These match STYLE.md. When one fires, the right response is usually to
         ask rather than to split the file into five. -->
    <module name="MethodLength">
      <property name="max" value="40"/>
      <property name="countEmpty" value="false"/>
    </module>
    <module name="FileLength">
      <property name="max" value="250"/>
    </module>
    <module name="ParameterNumber">
      <!-- 7 not 3: a record or a DTO constructor legitimately has more.
           STYLE.md asks you to pause at 3; this fails only at absurd. -->
      <property name="max" value="7"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>

    <!-- ── real bugs, not style ──────────────────────────────────────────── -->
    <!-- Braces always. The classic single-statement-if bug. -->
    <module name="NeedBraces"/>
    <!-- A switch without default, or one that falls through by accident. -->
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <!-- Two returns in one boolean expression, assignment inside a condition. -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="InnerAssignment"/>
    <!-- Comparing strings or boxed types with ==. Bites every fresher once. -->
    <module name="StringLiteralEquality"/>
    <!-- equals without hashCode, and equals(null). -->
    <module name="EqualsHashCode"/>
    <!-- An empty catch that swallows the problem silently. -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <!-- Catching Exception or Throwable hides the one you needed to see. -->
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Throwable,java.lang.Error"/>
    </module>

    <!-- ── naming, so a reader can guess ─────────────────────────────────── -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>
    <module name="PackageName"/>

    <!-- ── project-specific: never log a secret ──────────────────────────── -->
    <!-- Best-effort. The security review is the real check; this catches the
         obvious case where a key ends up in a log line. -->
    <module name="Regexp">
      <property name="format" value="log\.(info|debug|warn|error|trace)\([^)]*(masterWrappedBek|wrappedBek|password|secret|masterKey|privateKey)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Never log a key, token or password. See STYLE.md."/>
    </module>

    <!-- ── project-specific: no field injection ──────────────────────────── -->
    <module name="Regexp">
      <property name="format" value="@Autowired\s*\n\s*(private|protected|public)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use constructor injection via @RequiredArgsConstructor. See STYLE.md."/>
    </module>

    <!-- ── project-specific: @Data is banned ─────────────────────────────── -->
    <module name="Regexp">
      <property name="format" value="^\s*@Data\s*$"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="@Data is banned: it generates a setter for every field. Use @Getter, or a record. See STYLE.md."/>
    </module>

    <!-- ── TODO without an owner will still be there in week 8 ───────────── -->
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME)(?!.*@\w)"/>
      <property name="severity" value="warning"/>
    </module>

  </module>
</module>
